{
    "name": "stougeiro/pdo-database",
    "description": "A dialect-agnostic PDO model for SQLite, MySQL, MariaDB and PostgreSQL.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "pdo",
        "database",
        "sql",
        "sqlite",
        "mysql",
        "mariadb",
        "postgresql",
        "model",
        "driver",
        "query-builder",
        "pagination",
        "transactions",
        "prepared-statements",
        "emulation"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/pdo-database/issues",
        "source": "https://github.com/stougeiro/pdo-database"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Pdo\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/pdo-contract": "^1.0.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest",
        "cover": "vendor/bin/pest --coverage",
        "bench": "BENCH=1 vendor/bin/pest tests/Performance"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
